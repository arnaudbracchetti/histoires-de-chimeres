# Copier en load-test/.env (ignoré par git), puis remplir. Jamais d'identifiant dans le dépôt.
# Serveur visé, test2 par défaut.
BASE_URL=https://test2.nekbet.fr
# Organisateur de test2 : ORGANIZER_PSEUDO / ORGANIZER_PASSWORD de son .env sur le serveur.
ORGANIZER_PSEUDO=
ORGANIZER_PASSWORD=
# Nombre de téléphones : 1 pour la mesure de référence, puis 80, 160 et 240.
PHONES=1
