{
  "name": "@chimeres/draw",
  "version": "0.0.0",
  "private": true,
  "description": "Algorithmes de tirage, derrière l'interface DrawAlgorithm du domaine (ADR 0014), et leur suite de tests de contrat. TypeScript pur : ne dépend que de domain.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
