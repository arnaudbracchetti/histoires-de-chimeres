# Copier en .env. Lu par l'API (dotenv) et par la CLI Prisma (prisma.config.ts).
# Correspond au service postgres de docker-compose.yml (`pnpm dev:db`).
DATABASE_URL=postgresql://chimeres:chimeres@localhost:5435/chimeres?schema=public

# Clés VAPID du push web (`pnpm dlx web-push generate-vapid-keys`).
# Sans elles, aucune notification ne part et le front office affiche « Ce téléphone ne reçoit pas les notifications ».
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact donné aux services push : mailto:… ou https://…
VAPID_SUBJECT=
# Adresse du front office, que les notifications ouvrent. Sans elle non plus, rien ne part.
# Elle sert aussi à construire les liens d'accès (ADR 0018) : en dev, le back office est sur :4201,
# remplacer le port dans le lien copié.
PUBLIC_URL=http://localhost:4200

# Premier Organisateur (ADR 0016), appliqué au démarrage, une fois par valeur. Paire de dev, connue :
# en production, elle vit dans les secrets du déploiement. Les deux, ou aucune.
ORGANIZER_PSEUDO=Organisateur
ORGANIZER_PASSWORD=mot de passe de dev
