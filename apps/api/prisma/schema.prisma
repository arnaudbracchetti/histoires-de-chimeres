generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Convention {
  id      String    @id @default(uuid()) @db.Uuid
  name    String
  date    DateTime? @db.Date
  /// Verrou optimiste : chaque sauvegarde de l'agrégat l'incrémente.
  version Int       @default(0)
}
