generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Convention {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  date         DateTime?    @db.Date
  /// Verrou optimiste : chaque sauvegarde de l'agrégat l'incrémente.
  version      Int          @default(0)
  /// Code de présence (ID-2) : tiré au hasard par la base à la création de la convention, il ne
  /// change plus. La fonction vient de la migration presence_code.
  presenceCode String       @default(dbgenerated("random_presence_code()"))
  timeSlots    TimeSlot[]
  tables       Table[]
  gameMasters  GameMaster[]
  participants Participant[]
  games        Game[]
}

/// Créneau de la convention. Ses heures sont en minutes depuis minuit, de 0 à 1439.
model TimeSlot {
  id             String         @id @db.Uuid
  conventionId   String         @db.Uuid
  convention     Convention     @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  startMinute    Int
  endMinute      Int
  availabilities Availability[]
  games          GameTimeSlot[]

  @@index([conventionId])
}

/// Table de la convention. Son nom est unique dans la convention, à la casse, aux accents et aux
/// espaces près : le domaine le vérifie (PR-9).
model Table {
  id           String         @id @db.Uuid
  conventionId String         @db.Uuid
  convention   Convention     @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  name         String
  games        GameTimeSlot[]

  @@index([conventionId])
}

/// MJ de la convention. Son pseudo est unique parmi les MJ, à la casse, aux accents et aux espaces
/// près : le domaine le vérifie (PR-12, ID-7).
model GameMaster {
  id             String         @id @db.Uuid
  conventionId   String         @db.Uuid
  convention     Convention     @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  nickname       String
  availabilities Availability[]
  scenarios      Scenario[]
  games          GameTimeSlot[]

  @@index([conventionId])
}

/// Participant de la convention (ID-1). Son pseudo est unique parmi les participants, à la casse,
/// aux accents et aux espaces près : le domaine le vérifie (ID-7). Il ne se modifie pas (ID-9).
model Participant {
  id           String        @id @db.Uuid
  conventionId String        @db.Uuid
  convention   Convention    @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  nickname     String
  linkedPhones LinkedPhone[]

  @@index([conventionId])
}

/// Téléphone relié à un pseudo (ADR 0009), hors de l'agrégat de la convention. Son identifiant,
/// opaque, est la valeur du cookie du téléphone. Il part avec son participant.
model LinkedPhone {
  id            String      @id
  participantId String      @db.Uuid
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  linkedAt      DateTime    @default(now())

  @@index([participantId])
}

/// Disponibilité d'un MJ sur un créneau (PR-2). Elle part avec son créneau ou son MJ (PR-10, PR-12).
model Availability {
  gameMasterId String     @db.Uuid
  gameMaster   GameMaster @relation(fields: [gameMasterId], references: [id], onDelete: Cascade)
  timeSlotId   String     @db.Uuid
  timeSlot     TimeSlot   @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@id([gameMasterId, timeSlotId])
  @@index([timeSlotId])
}

/// Scénario d'un MJ, fixé à sa création (PR-16). Agrégat à part de la convention (ADR 0005). Un MJ
/// qui a des scénarios ne se supprime pas : la clé étrangère le refuse (RESTRICT).
model Scenario {
  id              String          @id @db.Uuid
  gameMasterId    String          @db.Uuid
  gameMaster      GameMaster      @relation(fields: [gameMasterId], references: [id], onDelete: Restrict)
  title           String
  system          String
  presentation    String
  /// Vide sans avertissement.
  contentWarnings String
  seatsMin        Int
  seatsMax        Int
  /// En créneaux : 1 ou 2.
  duration        Int
  /// L'image servie, ou rien : l'illustration par défaut (PR-7).
  imageId         String?         @db.Uuid
  images          ScenarioImage[]
  games           Game[]

  @@index([gameMasterId])
}

/// Image d'un scénario, en WebP (ADR 0007). À part du scénario, pour que les listes ne chargent
/// jamais les octets. Elle part avec son scénario.
model ScenarioImage {
  id         String   @id @db.Uuid
  scenarioId String   @db.Uuid
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  bytes      Bytes

  @@index([scenarioId])
}

/// Partie de la convention : un scénario programmé (PR-3). Un scénario qui a des parties ne se
/// supprime pas : la clé étrangère le refuse (RESTRICT).
model Game {
  id           String         @id @db.Uuid
  conventionId String         @db.Uuid
  convention   Convention     @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  scenarioId   String         @db.Uuid
  scenario     Scenario       @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  /// L'ordre de programmation.
  scheduledAt  DateTime       @default(now())
  timeSlots    GameTimeSlot[]

  @@index([conventionId])
  @@index([scenarioId])
}

/// Un créneau d'une partie, une ligne par créneau. La table et le MJ y sont recopiés : les index
/// uniques sont le filet de PR-5, que le domaine garantit.
model GameTimeSlot {
  gameId       String     @db.Uuid
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  timeSlotId   String     @db.Uuid
  timeSlot     TimeSlot   @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  tableId      String     @db.Uuid
  table        Table      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  gameMasterId String     @db.Uuid
  gameMaster   GameMaster @relation(fields: [gameMasterId], references: [id], onDelete: Restrict)

  @@id([gameId, timeSlotId])
  @@unique([timeSlotId, tableId])
  @@unique([timeSlotId, gameMasterId])
  @@index([tableId])
  @@index([gameMasterId])
}
