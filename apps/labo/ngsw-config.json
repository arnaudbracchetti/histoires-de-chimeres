{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/*.webmanifest", "/*.css", "/*.js", "/media/*.woff2"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|png|woff2)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "programme",
      "urls": ["/api/programme"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxAge": "7d",
        "maxSize": 5
      }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"]
}
