{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "labo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "labo",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "assets": [
              { "glob": "**/*", "input": "public" },
              { "glob": "*.png", "input": "node_modules/@chimeres/design/pwa", "output": "icons" }
            ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "labo:build:production" },
            "development": { "buildTarget": "labo:build:development" }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4210,
            "proxyConfig": "proxy.conf.json",
            "prebundle": { "exclude": ["@chimeres/design"] }
          }
        }
      }
    }
  }
}
