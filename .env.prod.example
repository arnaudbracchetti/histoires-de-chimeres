# Copier vers /opt/histoires-de-chimeres/.env sur le serveur (jamais committé) et adapter.
# Consommé par docker-compose.prod.yml ; PUBLIC_DOMAIN sert à préparer histoires-de-chimeres.caddy,
# et donne l'adresse que les notifications ouvrent.

PUBLIC_DOMAIN=chimeres.example.org
IMAGE_TAG=v0.1.0

POSTGRES_USER=chimeres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chimeres

# Clés VAPID du push web (`pnpm dlx web-push generate-vapid-keys`) et contact (mailto:… ou https://…).
# Sans elles, aucune notification ne part et le front office affiche « Ce téléphone ne reçoit pas les notifications ».
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
