# Copier vers /opt/hdc/.env sur le serveur (jamais committé), chmod 600, et adapter.
# Procédure complète : docs/deploy-production.md. Copie du fichier rempli dans Dashlane
# (fiche « hdc production »).
# Consommé par docker-compose.prod.yml ; PUBLIC_DOMAIN sert à préparer histoires-de-chimeres.caddy,
# et donne l'adresse que les notifications ouvrent.

PUBLIC_DOMAIN=hdc.nekbet.fr
IMAGE_TAG=v0.1.0

POSTGRES_USER=chimeres
# Mot de passe par `openssl rand -hex 32` : rien à échapper dans DATABASE_URL.
POSTGRES_PASSWORD=
POSTGRES_DB=chimeres

# Clés VAPID du push web (`pnpm dlx web-push generate-vapid-keys`, une seule fois, sur le poste).
# Ne jamais régénérer les clés VAPID : une nouvelle clé oblige chaque téléphone à se réabonner.
# Sans elles, aucune notification ne part et le front office affiche « Ce téléphone ne reçoit pas les notifications ».
# VAPID_SUBJECT : le site, pas d'adresse personnelle.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://hdc.nekbet.fr

# Premier Organisateur (ADR 0016) : appliqué au démarrage, une fois par valeur. Mot de passe de 10 à
# 128 caractères, différent du pseudo. Les deux, ou aucune ; sinon l'API refuse de démarrer.
# Pour reprendre la main, changer la valeur et redéployer.
ORGANIZER_PSEUDO=
ORGANIZER_PASSWORD=

# Sauvegarde de nuit sur Backblaze B2 (deploy-hdc.sh sauvegarde-nuit) : clé d'application limitée
# au bucket, sans deleteFiles. B2_KEY_ID est l'identifiant de la clé (keyID), pas celui du compte.
# B2_BUCKET est le nom du bucket, pas son ID : avec un nom inconnu, rclone crée un autre bucket.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
