# Bloc de site pour le Caddy « edge » du serveur (sites/histoires-de-chimeres.caddy).
# __PUBLIC_DOMAIN__ est remplacé par sed avant dépôt, jamais par une variable {$VAR} de Caddy.
__PUBLIC_DOMAIN__ {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        # « ? » : seulement si l'app n'en pose pas. La page d'un lien d'accès garde son
        # « no-referrer » (ADR 0018) ; « -Server » applique le bloc après la réponse de l'app.
        ?Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        -Server
    }

    reverse_proxy chimeres-app:3000 {
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Real-IP {http.request.remote.host}
    }
}
